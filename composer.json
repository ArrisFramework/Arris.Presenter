{
    "name": "karelwintersky/arris.presenter",
    "description": "Presenter for Arris µ-framework, including lazy wrapper over Smarty",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Karel Wintersky",
            "email": "karel.wintersky@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "smarty/smarty": "v4.5.7",
        "karelwintersky/arris.entity": "^2",
        "psr/log": "*"

    },
    "autoload": {
        "psr-4": {
            "Arris\\Presenter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}
